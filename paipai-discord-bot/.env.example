# Copie ce fichier en ".env" et remplis les valeurs (voir README.md pour
# savoir où trouver chacune d'elles). Ne partage JAMAIS le contenu de .env.

BOT_TOKEN=colle_ton_token_ici
GUILD_ID=colle_l_id_de_ton_serveur_ici

# Age minimum du compte Discord (en jours) pour passer la verification
# anti-multi-compte. 7 par defaut.
MIN_ACCOUNT_AGE_DAYS=7

# --- Pilotage a distance depuis PaiPai (Bot Manager) ---
# Cle secrete partagee entre le bot et PaiPai. Sans elle, l'API de controle ne
# demarre pas du tout (aucun risque d'exposition par oubli). 16 caracteres
# minimum ; genere-en une longue et aleatoire, et colle la MEME valeur dans le
# champ "Control key" du profil de bot cote PaiPai.
CONTROL_KEY=

# Port d'ecoute de l'API de controle. La plupart des hebergeurs imposent leur
# propre variable PORT, qui a la priorite -> a ne renseigner qu'en local.
CONTROL_PORT=8080
