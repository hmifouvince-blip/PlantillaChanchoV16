# Copie ce fichier en ".env" et remplis les valeurs (voir README.md pour
# savoir où trouver chacune d'elles). Ne partage JAMAIS le contenu de .env.

BOT_TOKEN=colle_ton_token_ici
GUILD_ID=colle_l_id_de_ton_serveur_ici

# Age minimum du compte Discord (en jours) pour passer la verification
# anti-multi-compte. 7 par defaut.
MIN_ACCOUNT_AGE_DAYS=7

# --- Pilotage a distance depuis PaiPai (Bot Manager) ---
# Cle secrete partagee entre le bot et PaiPai. Sans elle, l'API de controle ne
# demarre pas du tout (aucun risque d'exposition par oubli). 16 caracteres
# minimum ; genere-en une longue et aleatoire, et colle la MEME valeur dans le
# champ "Control key" du profil de bot cote PaiPai.
CONTROL_KEY=

# Port d'ecoute de l'API de controle. La plupart des hebergeurs imposent leur
# propre variable PORT, qui a la priorite -> a ne renseigner qu'en local.
CONTROL_PORT=8080

# --- Livraison automatique des licences (KeyAuth) ---
# Cle VENDEUR de ton application KeyAuth (dashboard -> Seller Settings).
# Sans elle, le bouton "Payment received -> deliver" explique quoi configurer
# et ne genere rien : aucune livraison automatique.
#
# ATTENTION : c'est un secret MAITRE (creer/supprimer licences et comptes).
# Il se colle UNIQUEMENT dans les variables d'environnement de l'hebergeur,
# jamais dans le depot, jamais dans PaiPai, jamais dans un salon Discord.
# Si tu le soupconnes expose : regenere-le depuis le dashboard KeyAuth.
KEYAUTH_SELLER_KEY=

# Format des cles generees ("*" = caractere aleatoire). Optionnel.
KEYAUTH_KEY_MASK=******-******-******-******

# --- Inscription sans licence dans l'application PaiPai ---
# Niveau KeyAuth utilise pour les comptes gratuits. Cree sur le dashboard un
# abonnement dedie (ex: "Free") a un niveau qui n'est utilise par AUCUN
# produit, et mets son niveau ici. Vide = inscription sans cle desactivee.
#
# ATTENTION : ce niveau ne doit correspondre a aucun produit, sinon la route
# publique /signup-key distribuerait ton catalogue gratuitement.
KEYAUTH_FREE_LEVEL=

# Duree de la cle de compte gratuit, en jours. 0 = a vie (recommande : le
# compte ne debloque rien, il sert juste a se connecter).
KEYAUTH_FREE_DAYS=0
