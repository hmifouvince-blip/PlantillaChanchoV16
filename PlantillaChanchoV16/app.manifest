<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="PaiPai.app"/>

  <!-- PaiPai a besoin des droits administrateur : installation des polices Inter
       dans C:\Windows\Fonts + ecriture dans HKEY_LOCAL_MACHINE (Program.cs), et
       les tweaks Windows PaiPai lancent des commandes PowerShell systeme.
       "requireAdministrator" fait afficher l'invite UAC par Windows AU LANCEMENT :
       plus de "clic droit -> Executer en tant qu'administrateur", et l'icone de
       l'exe porte le bouclier.
       ATTENTION : ce fichier ne sert a RIEN tant que <ApplicationManifest> n'est
       pas renseigne dans le .csproj -- c'etait le cas jusqu'ici (balise vide),
       d'ou l'ancien message "The application must be run as administrator". -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Sans cette liste, Windows fait croire a l'application qu'elle tourne sur
       Windows 8 (Environment.OSVersion plafonne a 6.2) -> les verifications de
       version faites par Windows PaiPai deviendraient fausses. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
    </application>
  </compatibility>

  <!-- Volontairement AUCUN reglage dpiAware : WinForms .NET fixe le mode DPI a
       l'execution. Le declarer ici le figerait AVANT le demarrage et changerait
       la mise a l'echelle de toutes les fenetres, qui sont positionnees en
       coordonnees absolues. -->
</assembly>
